# Resend sending API key (server only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A sender on a domain verified in Resend
RESEND_FROM_EMAIL="RUNAWAY <orders@example.com>"
# Required: receive a notification for each paid order
ORDER_NOTIFICATION_EMAIL=orders@example.com
# Optional: add newsletter subscribers directly to a Resend segment
RESEND_NEWSLETTER_SEGMENT_ID=
# Paystack secret key (start with a test key; server-side only)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Enable only after the public test-mode checkout and webhook checks pass.
PAYSTACK_LIVE_ENABLED=false

# Paystack webhook signing secret (whole whsec_ value)
PAYSTACK_WEBHOOK_SECRET=
# Optional previous signing secret during rotation
PAYSTACK_PREVIOUS_WEBHOOK_SECRET=
# Only enable for accounts still using x-paystack-signature
PAYSTACK_ALLOW_LEGACY_WEBHOOKS=false

# Shared order database. All values below are SERVER ONLY.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Confirmed Supabase Auth user's email; no public signup is needed
ADMIN_EMAIL=owner@example.com
# Owner secret key / passcode for admin login (bypasses Supabase Auth user verification)
ADMIN_SECRET_KEY=
# Resend webhook signing secret
RESEND_WEBHOOK_SECRET=
# Random secret protecting the email retry worker (at least 32 random bytes)
CRON_SECRET=
