# Resend sending API key (server only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A sender on a domain verified in Resend
RESEND_FROM_EMAIL="RUNAWAY <orders@example.com>"
# Optional: receive a copy of each new order
ORDER_NOTIFICATION_EMAIL=orders@example.com
# Optional: add newsletter subscribers directly to a Resend segment
RESEND_NEWSLETTER_SEGMENT_ID=
# Paystack secret key (start with a test key; server-side only)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
